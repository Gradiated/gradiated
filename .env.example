# Copy variable names into the external secret store used by the server.
# Never put secret values in this file or in the repository.

# Optional browser/research providers
BROWSER_USE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# Research infrastructure
RUNPOD_API_KEY=

# Product API (local values belong in an ignored .env file)
# Production: BETTER_AUTH_URL=https://api.gradiated.com
# Production: TRUSTED_ORIGINS=https://console.gradiated.com
# Production: CONSOLE_URL=https://console.gradiated.com
DATABASE_URL=
AUTH_EMAIL_FROM=
AUTH_TEST_MODE=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SES_REGION=
TRUSTED_ORIGINS=
VALKEY_URL=
SGLANG_API_KEY=
GATEWAY_BIND_ADDRESS=
GATEWAY_GENERATION_TIMEOUT_SECONDS=
CONSOLE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Console build
# Production: VITE_API_URL=https://api.gradiated.com
VITE_API_URL=
