# Copy variable names into the external secret store used by the server.
# Never put secret values in this file or in the repository.

# Management API (local values belong in an ignored .env file)
# Production: BETTER_AUTH_URL=https://api.gradiated.com
# Local: TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production: TRUSTED_ORIGINS=https://console.gradiated.com,https://gradiated.com,https://www.gradiated.com
# Production: CONSOLE_URL=https://console.gradiated.com
DATABASE_URL=
AUTH_EMAIL_FROM=Gradiated <auth@mail.gradiated.com>
AUTH_TEST_MODE=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
CLICKHOUSE_DATABASE=
CLICKHOUSE_HOST=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_PORT=
CLICKHOUSE_SECURE=
CLICKHOUSE_USERNAME=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
TRUSTED_ORIGINS=
VALKEY_URL=
SGLANG_API_KEY=
GATEWAY_BIND_ADDRESS=
GATEWAY_GENERATION_TIMEOUT_SECONDS=
CONSOLE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
GLM_5_3_FLASH_SERVICE_URLS=
GLM_5_3_FLASH_REGION=
GLM_5_3_FLASH_FAULT_DOMAIN=
TELEMETRY_HOST=
TELEMETRY_PORT=

# Desmond deployment status
DESMOND_DEPLOYMENT_ID=
DESMOND_STATUS_HOST=
DESMOND_STATUS_PORT=
DESMOND_STATUS_PATH=
DESMOND_STATUS_TOKEN=

# Content storage (production uses AWS; local defaults are in product/mprocs.yaml)
CONTENTS_BUCKET=
TRAINING_ARTIFACTS_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ALLOW_HTTP=
COLLECTOR_BUCKET=
COLLECTOR_DATA_DIR=
COLLECTOR_TOKEN=
PROXY_COLLECTOR_URL=
PROXY_COLLECTOR_TOKEN=

# Temporal (production: the temporal ExternalSecret; local: the dev server in
# product/docker-compose.yml at localhost:7233, namespace default, no API key)
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_PAYLOAD_KEY_ID=
TEMPORAL_PAYLOAD_KEYS=
# Training: qwen-sft for the GPU executor, mock for local orchestration tests.
TRAINING_EXECUTOR=
TRAINING_POD_IDS=
TRAINING_BUNDLE_URL=
TRAINING_BUNDLE_SHA256=
TRAINING_BASE_ID=
TRAINING_GPU_MODEL=
TRAINING_HOST_TOKEN=
TRAINING_ARTIFACTS_BUCKET=

# Console build
# Production: VITE_API_URL=https://api.gradiated.com
VITE_API_URL=
# PostHog project client token (public). Production: the CONSOLE_POSTHOG_KEY repository variable; local: the Development project, set in mprocs.yaml.
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com
# API analytics: use the same project as the console in each environment.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Local only: comma-separated feature flags to force on without PostHog, e.g. training
VITE_FEATURE_FLAGS=
# Shared development provider keys for the proxy live suite (pnpm --filter @gradiated/proxy test:live). Never production keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Production ops MCP (OAuth state belongs on private persistent storage, never Git)
MCP_HOST=ops.gradiated.com
MCP_OIDC_SECRET_FILE=
MCP_SESSION_FILE=
MCP_REDIRECT_URIS=[]
MCP_DENIED_EMAILS=[]
PROMETHEUS_URL=
LOKI_URL=

# Sync Drata: policy and evidence uploads (in CI, loaded from gradiated/prod/platform/drata in AWS Secrets Manager)
DRATA_API_KEY=
# Optional Actions repository variable; allowed hosts are documented in the policy README.
DRATA_API_HOST=public-api.drata.com

# PandaDoc NDA signing (server-only; use a sandbox key locally)
PANDADOC_API_KEY=
PANDADOC_NDA_ENABLED=false
PANDADOC_NDA_TEMPLATE_ID=bTmxaYhTaU2tQ28fLhVrHn
PANDADOC_NDA_TEMPLATE_VERSION=
PANDADOC_NDA_DATE_FIELD=Agreement.Date
# Local website signing preview; recipient must use the sandbox key's allowed domain
PANDADOC_SANDBOX_PREVIEW=false
PANDADOC_SANDBOX_SIGNER_EMAIL=
