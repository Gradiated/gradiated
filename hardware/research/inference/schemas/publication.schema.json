{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "publication_id": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "illustrative_figures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "publication_id",
    "runs"
  ],
  "additionalProperties": false
}
