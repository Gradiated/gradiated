{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradiated.com/hardware/schemas/run-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "aborted",
        "inconclusive"
      ]
    },
    "evidence_type": {
      "enum": [
        "software",
        "rtl-simulation",
        "implementation-report",
        "physical-measurement",
        "analytical-estimate"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "patch_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "commit",
        "patch_sha256"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "object"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "configuration",
        "configuration_sha256"
      ],
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quality_gate": {
          "type": "string",
          "minLength": 1
        },
        "tokenizer": {
          "type": "string",
          "minLength": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "context_limit": {
          "type": "integer",
          "minimum": 1
        },
        "warmup": {
          "type": "string",
          "minLength": 1
        },
        "measurement_boundary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "sha256",
        "quality_gate",
        "tokenizer",
        "batch_size",
        "concurrency",
        "context_limit",
        "warmup",
        "measurement_boundary"
      ],
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "passed",
        "evidence"
      ],
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "passed",
        "evidence"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 1
          },
          "kind": {
            "enum": [
              "observed",
              "derived"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "unit",
          "samples",
          "kind",
          "method"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "experiment_id",
    "status",
    "evidence_type",
    "source",
    "model",
    "implementation",
    "workload",
    "device",
    "protocol",
    "correctness",
    "quality",
    "conditions",
    "started_at",
    "completed_at",
    "metrics",
    "artifacts",
    "limitations",
    "supersedes"
  ],
  "additionalProperties": false
}
