+    def _cartridge_spec(self, ref: CartridgeRef) -> Cartridge:
+        spec = self.cartridge_specs.get(ref.sha256)
+        if spec is None or spec.path != ref.path or spec.num_tokens != ref.num_tokens:
+            spec = read_cartridge(
+                ref.path,
+                sha256=ref.sha256,
+                num_tokens=ref.num_tokens,
+                hidden_size=self.model_config.hidden_size,
+                vocab_size=self.model_config.vocab_size,
+            )
+            self.cartridge_specs[ref.sha256] = spec
+        self.cartridge_specs.move_to_end(ref.sha256)
+        while len(self.cartridge_specs) > 4096:
+            self.cartridge_specs.popitem(last=False)
+        return spec
+
+    def _load_cartridge(self, ref: CartridgeRef, rows) -> None:
+        self.cartridge_table.write(self._cartridge_spec(ref), rows)
+
+    def _validate_cartridge_req(self, req: Req) -> Optional[str]:
+        ref = req.cartridge
+        if self.cartridge_pool is None:
+            return "Cartridges are not enabled"
+        if not self.cartridge_pool.fits(ref.num_tokens):
+            return "Cartridge exceeds the cartridge pool"
+        try:
+            spec = self._cartridge_spec(ref)
+        except (CartridgeError, OSError):
+            return "Cartridge file is invalid"
+        slots = req.origin_input_ids[ref.start : ref.start + ref.num_tokens]
+        if ref.start < 0 or tuple(slots) != spec.slot_token_ids:
+            return "Cartridge positions do not hold its slot tokens"
+        return None
+
