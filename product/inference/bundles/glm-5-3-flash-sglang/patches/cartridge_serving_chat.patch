+def _message_field(message, name):
+    return message[name] if isinstance(message, dict) else getattr(message, name)
+
+
+def _with_field(value, name, new):
+    if isinstance(value, dict):
+        return {**value, name: new}
+    return value.model_copy(update={name: new})
+
+
+PROTOCOL_MESSAGES = MessageAdapter(
+    role=lambda message: _message_field(message, "role"),
+    content=lambda message: _message_field(message, "content"),
+    with_content=lambda message, content: _with_field(message, "content", content),
+    system=lambda content: ChatCompletionMessageGenericParam(
