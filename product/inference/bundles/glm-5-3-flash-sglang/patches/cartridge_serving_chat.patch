+    def _place_cartridge(
+        self,
+        request: ChatCompletionRequest,
+        is_multimodal: bool,
+        cartridge: tuple[Cartridge, str],
+    ) -> tuple[MessageProcessingResult, CartridgeRef]:
+        spec, slot_text = cartridge
+        if request.input_ids is not None or request.session_id is not None:
+            raise ValueError("Cartridge requests take chat messages without a session")
+
+        def render(messages):
+            processed = self._process_messages(
+                request.model_copy(update={"messages": messages}, deep=True),
+                is_multimodal,
+            )
+            if not isinstance(processed.prompt_ids, list) or any(
+                (processed.image_data, processed.video_data, processed.audio_data)
+            ):
+                raise ValueError("Cartridge requests take text chat messages")
+            return processed.prompt_ids, processed
+
+        processed, start = place_cartridge(
+            render, request.messages, spec, slot_text, PROTOCOL_MESSAGES
+        )
+        return processed, CartridgeRef(
+            sha256=spec.sha256,
+            path=spec.path,
+            num_tokens=spec.num_tokens,
+            start=start,
+        )
+
