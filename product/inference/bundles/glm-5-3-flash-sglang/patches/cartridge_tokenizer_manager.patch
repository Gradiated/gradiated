+    def _register_cartridge(self, name: str, resolved: Dict[str, Any]) -> None:
+        if self.cartridge_pool_bytes <= 0:
+            raise ValueError("Cartridges are not enabled")
+        sha256, num_tokens = resolved.get("sha256"), resolved.get("num_tokens")
+        if (
+            not isinstance(sha256, str)
+            or len(sha256) != 64
+            or type(num_tokens) is not int
+            or num_tokens <= 0
+        ):
+            raise ValueError("Adapter resolution unavailable")
+        hidden_size = self.model_config.hidden_size
+        if num_tokens * hidden_size * 2 > self.cartridge_pool_bytes:
+            raise ValueError("Cartridge exceeds the cartridge pool")
+        try:
+            cartridge = read_cartridge(
+                resolved["path"],
+                sha256=sha256,
+                num_tokens=num_tokens,
+                hidden_size=hidden_size,
+                vocab_size=self.model_config.vocab_size,
+            )
+        except (CartridgeError, OSError):
+            logger.warning("Resolved cartridge failed validation")
+            raise ValueError("Adapter load failed") from None
+        slot_text = self.tokenizer.decode(list(cartridge.slot_token_ids))
+        self.cartridges[name] = (cartridge, slot_text)
+        self.cartridges.move_to_end(name)
+        while len(self.cartridges) > 4096:
+            self.cartridges.popitem(last=False)
+
+    async def resolve_cartridge(self, name: str) -> Optional[Tuple[Cartridge, str]]:
+        """The cartridge and its slot text when ``name`` names one, else None."""
+        if self.cartridge_pool_bytes <= 0 or name in self.lora_ref_cache:
+            return None
+        if name not in self.cartridges and self.lora_resolver_url:
+            await self._resolve_lora_adapter(name)
+        entry = self.cartridges.get(name)
+        if entry is not None:
+            self.cartridges.move_to_end(name)
+        return entry
 
