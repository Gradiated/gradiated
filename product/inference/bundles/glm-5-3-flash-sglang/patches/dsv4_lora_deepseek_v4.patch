+
+    # The indexer, compressor and engram reuse the leaves wq_b/wkv and are not
+    # adapted; routed experts have no LoRA hook on their MXFP4/NVFP4 runners.
+    _lora_module_pattern = re.compile(
+        r"^model\.layers\.\d+\.(?:self_attn\.(?:wq_a|wq_b|wkv|wo_a|wo_b)"
+        r"|mlp\.shared_experts\.(?:gate_up_proj|down_proj))$"
+    )
+    # "...layers.N.ffn.experts.E.w1..." or fused "...ffn.experts.w1...", not shared_experts
+    _routed_expert_lora_pattern = re.compile(r"(?<!shared_)experts\.")
+
+    def should_apply_lora(self, module_name: str) -> bool:
+        return bool(self._lora_module_pattern.match(module_name))
+
+    @staticmethod
+    def get_lora_target_module_name(name: str) -> str:
+        """Map checkpoint-native PEFT targets to the served modules: w1/w3/w2 are
+        the shared expert's gate/up/down (routed experts are not served) and a
+        bare wq_b is the attention's, not the indexer's (which is not served)."""
+        parent, _, leaf = name.rpartition(".")
+        if leaf in ("w1", "w2", "w3"):
+            return {"w1": "gate_proj", "w2": "down_proj", "w3": "up_proj"}[leaf]
+        if leaf == "wq_b" and not parent:
+            return "self_attn.wq_b"
+        return name
+
+    def validate_lora_weight_names(self, names: List[str]) -> None:
+        routed = [n for n in names if self._routed_expert_lora_pattern.search(n)]
+        if routed:
+            raise ValueError(
+                "DeepSeek-V4 LoRA serves attention and shared-expert adapters only; "
+                f"{len(routed)} routed-expert tensor(s) (e.g. {routed[0]!r}) "
+                "cannot be applied"
+            )
+
+    def get_hidden_dim(self, module_name: str, layer_idx: int) -> Tuple[int, int]:
+        """LoRA input/output dims; every layer is MoE, so gate_up/down are the shared expert's."""
+        config = self.config
+        if module_name in ("embed_tokens", "lm_head"):
+            from sglang.srt.lora.utils import get_default_hidden_dim
+
+            return get_default_hidden_dim(module_name, config, layer_idx)
+        shared_inter = config.moe_intermediate_size * config.n_shared_experts
+        return {
+            "wq_a": (config.hidden_size, config.q_lora_rank),
+            "wq_b": (config.q_lora_rank, config.num_attention_heads * config.head_dim),
+            "wkv": (config.hidden_size, config.head_dim),
+            "wo_a": (
+                config.num_attention_heads * config.head_dim // config.o_groups,
+                config.o_groups * config.o_lora_rank,
+            ),
+            "wo_b": (config.o_groups * config.o_lora_rank, config.hidden_size),
+            "gate_up_proj": (config.hidden_size, 2 * shared_inter),
+            "down_proj": (shared_inter, config.hidden_size),
+        }[module_name]
