+    def _backup_endpoint_mamba(self, node_id: Optional[NodeId]) -> bool:
+        """Copy a prompt-end or request-end node's device Mamba state to host.
+
+        A walk-phase backup can queue the node's KV before the commit attaches
+        the state, and the post-insert incremental backup skips pending nodes.
+        """
+        if (
+            not self.mamba_prompt_end_checkpoint
+            or node_id is None
+            or self.cache_controller is None
+            or self.buffer_pipeline is not None
+            or self.is_write_back
+            or self.write_through_threshold != 1
+            or ComponentType.MAMBA not in self.components
+            or self.tree_core.is_root(node_id)
+            or not self.tree_core.is_backuped(node_id)
+        ):
+            return False
+        if any(
+            node_id in pending.publish_node_ids
+            for pending in self.ongoing_write_through.values()
+        ):
+            self.mamba_backup_after_ack.add(node_id)
+            return False
+        _, comp_xfers = self.tree_core.build_backup_spec(node_id)
+        if ComponentType.MAMBA not in comp_xfers:
+            return False
+        self._execute_and_commit_kv_backup(BackupKV([node_id]))
+        return node_id in self.ongoing_write_through
 
