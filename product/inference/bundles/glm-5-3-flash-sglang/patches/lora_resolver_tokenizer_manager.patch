+    def _fetch_lora_adapter_path(self, lora_name: str) -> str:
+        import urllib.request
+        import uuid
+
+        workspace, separator, name = lora_name.partition("/")
+        if not separator or not 0 < len(name) <= 300:
+            raise ValueError("Unknown model or adapter")
+        try:
+            if str(uuid.UUID(workspace)) != workspace:
+                raise ValueError
+        except ValueError:
+            raise ValueError("Unknown model or adapter") from None
+        request = urllib.request.Request(
+            self.lora_resolver_url,
+            data=json.dumps({"name": name, "workspace_id": workspace}).encode(),
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=180) as response:
+                data = response.read(65537)
+            if len(data) > 65536:
+                raise ValueError
+            path = json.loads(data)["path"]
+            if not isinstance(path, str) or not os.path.isabs(path):
+                raise ValueError
+        except Exception:
+            # Keep signed URLs, credentials and loader errors out of responses and logs.
+            raise ValueError("Adapter resolution unavailable") from None
+        return path
+
+    async def _resolve_lora_adapter(self, lora_name: str) -> None:
+        pending = self.lora_resolutions.get(lora_name)
+        if pending is not None:
+            await asyncio.shield(pending)
+            return
+        pending = asyncio.get_running_loop().create_future()
+        self.lora_resolutions[lora_name] = pending
+        try:
+            path = await asyncio.to_thread(self._fetch_lora_adapter_path, lora_name)
+            result = await self.load_lora_adapter(
+                LoadLoRAAdapterReqInput(lora_name=lora_name, lora_path=path)
+            )
+            if not result.success and lora_name not in self.lora_ref_cache:
+                logger.warning("Resolved LoRA adapter failed to load")
+                raise ValueError("Adapter load failed")
+            pending.set_result(None)
+        except BaseException as error:
+            pending.set_exception(
+                error if isinstance(error, ValueError) else ValueError("Adapter load failed")
+            )
+            pending.exception()
+            raise
+        finally:
+            self.lora_resolutions.pop(lora_name, None)
+
