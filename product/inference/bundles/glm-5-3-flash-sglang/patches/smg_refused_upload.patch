+    #[tokio::test]
+    async fn refused_upload_is_drained_and_preserves_native_error() {
+        use std::sync::atomic::AtomicUsize;
+        use futures::StreamExt;
+        let seen = Arc::new(AtomicUsize::new(0));
+        let counter = seen.clone();
+        let chunks = futures::stream::iter([
+            Ok::<_, std::io::Error>(Bytes::from_static(b"not-json")),
+            Ok(Bytes::from_static(b"still-not-json")),
+        ]).inspect(move |_| { counter.fetch_add(1, Ordering::SeqCst); });
+        let response = refuse_request(
+            echo_request(Body::from_stream(chunks)),
+            shed_response(StatusCode::TOO_MANY_REQUESTS, "admission_queue_full", "full"),
+            Duration::from_secs(30),
+        ).await;
+        assert_eq!(seen.load(Ordering::SeqCst), 2);
+        assert_eq!(response.status(), StatusCode::TOO_MANY_REQUESTS);
+        assert_eq!(response.headers()[RETRY_AFTER], "2");
+        let body = axum::body::to_bytes(response.into_body(), 4096).await.unwrap();
+        let value: serde_json::Value = serde_json::from_slice(&body).unwrap();
+        assert_eq!(value["error"]["code"], "admission_queue_full");
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn refused_stalled_upload_has_a_bounded_drain() {
+        let body = Body::from_stream(futures::stream::pending::<Result<Bytes, std::io::Error>>());
+        let started = tokio::time::Instant::now();
+        let response = refuse_request(echo_request(body), shed_response(
+            StatusCode::TOO_MANY_REQUESTS, "admission_queue_full", "full",
+        ), Duration::from_secs(7)).await;
+        assert_eq!(response.status(), StatusCode::TOO_MANY_REQUESTS);
+        assert_eq!(started.elapsed(), Duration::from_secs(7));
+    }
