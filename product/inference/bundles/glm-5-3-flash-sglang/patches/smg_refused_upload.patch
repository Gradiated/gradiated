+// Drain refused HTTP/1 uploads so a proxy can receive the native shed response.
+// Use the configured request timeout so supported slow uploads are not cut short.
+async fn refuse_request(request: Request<Body>, response: Response, timeout: Duration) -> Response {
+    let mut body = request.into_body();
+    let _ = tokio::time::timeout(timeout, async {
+        while let Some(frame) = body.frame().await {
+            if frame.is_err() {
+                break;
+            }
+        }
+    })
+    .await;
+    response
+}
