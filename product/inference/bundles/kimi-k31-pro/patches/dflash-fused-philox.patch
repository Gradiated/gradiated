+def seeded_dflash_uniforms(*, stock, seeds, positions, stream: int):
+    if seeds is None:
+        return stock
+    if positions is None:
+        raise ValueError('Seeded DFLASH requires absolute sampling positions.')
+    if stock.ndim != 2 or seeds.ndim != 1 or positions.ndim != 1:
+        raise ValueError('Seeded DFLASH uniform shape mismatch.')
+    if stock.shape[0] != seeds.numel() or positions.numel() != seeds.numel():
+        raise ValueError('Seeded DFLASH seed/position row mismatch.')
+    # Keep uncommon dtypes and CPU behavior on the untouched incumbent reference.
+    if (not stock.is_cuda or stock.dtype != torch.float32 or seeds.dtype != torch.int64
+            or positions.dtype != torch.int64 or stock.numel() == 0):
+        return seeded_dflash_uniforms_reference(stock=stock,seeds=seeds,positions=positions,stream=stream)
+    if seeds.device != stock.device or positions.device != stock.device:
+        raise ValueError('Seeded DFLASH seed/position device mismatch.')
+    output = torch.empty(stock.shape,device=stock.device,dtype=stock.dtype)
+    _uniform_kernel[(triton.cdiv(stock.numel(),128),)](
+        stock,seeds,positions,output,stock.numel(),stock.shape[1],stock.stride(0),stock.stride(1),
+        seeds.stride(0),positions.stride(0),stream,128,num_warps=4)
+    return output
