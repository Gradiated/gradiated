+@triton.jit
+def _uniform_kernel(Stock, Seeds, Positions, Output, N: tl.constexpr, W: tl.constexpr,
+                    S0: tl.constexpr, S1: tl.constexpr, SS: tl.constexpr, PS: tl.constexpr,
+                    STREAM: tl.constexpr, TILE: tl.constexpr):
+    offset = tl.program_id(0) * TILE + tl.arange(0, TILE)
+    valid = offset < N
+    row, column = offset // W, offset % W
+    seed = tl.load(Seeds + row * SS, valid, other=0).to(tl.int64)
+    position = tl.load(Positions + row * PS, valid, other=0).to(tl.uint64)
+    absolute = position + column.to(tl.uint64)
+    c0, c1 = absolute.to(tl.uint32), (absolute >> 32).to(tl.uint32)
+    c2 = tl.full((TILE,), STREAM, tl.uint32)
+    c3 = tl.full((TILE,), 0, tl.uint32)
+    key = seed.to(tl.uint64)
+    k0, k1 = key.to(tl.uint32), (key >> 32).to(tl.uint32)
+    a = tl.full((TILE,), 0xD2511F53, tl.uint32)
+    b = tl.full((TILE,), 0xCD9E8D57, tl.uint32)
+    for _ in tl.static_range(10):
+        hi_b, lo_b = libdevice.mulhi(c2, b), c2 * b
+        hi_a, lo_a = libdevice.mulhi(c0, a), c0 * a
+        c0, c1, c2, c3 = hi_b ^ c1 ^ k0, lo_b, hi_a ^ c3 ^ k1, lo_a
+        k0 = k0 + tl.full((TILE,), 0x9E3779B9, tl.uint32)
+        k1 = k1 + tl.full((TILE,), 0xBB67AE85, tl.uint32)
+    seeded = (c0 >> 8).to(tl.float32) * (2.0 ** -24)
+    stock = tl.load(Stock + row * S0 + column * S1, valid, other=0)
+    tl.store(Output + offset, tl.where(seed >= 0, seeded, stock), valid)
+
