@@ -0,0 +1,47 @@
+"""Counter-based DFLASH variates; candidate-only pending GPU qualification."""
+from __future__ import annotations
+
+import torch
+
+
+def _dflash_mul32(a: torch.Tensor, b: int):
+    # Same overflow-free 32-bit multiplication as DSpark markov_sample._mul32.
+    product_lo = a * (b & 0xFFFF)
+    product_hi = a * (b >> 16)
+    high = (product_hi + (product_lo >> 16)) >> 16
+    low = (((product_hi & 0xFFFF) << 16) + product_lo) & 0xFFFFFFFF
+    return high, low
+
+
+def seeded_dflash_uniforms(*, stock, seeds, positions, stream: int):
+    """Use Philox4x32-10(seed64, absolute position, stream) for seeded rows.
+
+    Stream0 proposes, stream1 accepts, stream2 samples residual/bonus. Positions
+    are absolute model token positions, matching the normal sampler's convention.
+    Caller supplies stock random draws; negative sentinel rows retain those.
+    No data-dependent CPU predicate, global generator reset, or batch-row key.
+    """
+    if seeds is None:
+        return stock
+    if positions is None:
+        raise ValueError("Seeded DFLASH requires absolute sampling positions.")
+    if stock.ndim != 2 or seeds.ndim != 1 or positions.ndim != 1:
+        raise ValueError("Seeded DFLASH uniform shape mismatch.")
+    if stock.shape[0] != seeds.numel() or positions.numel() != seeds.numel():
+        raise ValueError("Seeded DFLASH seed/position row mismatch.")
+    absolute = positions.to(torch.int64)[:, None] + torch.arange(
+        stock.shape[1], dtype=torch.int64, device=stock.device
+    )[None, :]
+    c0, c1 = absolute & 0xFFFFFFFF, (absolute >> 32) & 0xFFFFFFFF
+    c2, c3 = torch.full_like(c0, stream), torch.zeros_like(c0)
+    k0 = seeds.to(torch.int64)[:, None] & 0xFFFFFFFF
+    k1 = (seeds.to(torch.int64)[:, None] >> 32) & 0xFFFFFFFF
+    for _ in range(10):
+        hi_b, lo_b = _dflash_mul32(c2, 0xCD9E8D57)
+        hi_a, lo_a = _dflash_mul32(c0, 0xD2511F53)
+        c0, c1, c2, c3 = hi_b ^ c1 ^ k0, lo_b, hi_a ^ c3 ^ k1, lo_a
+        k0 = (k0 + 0x9E3779B9) & 0xFFFFFFFF
+        k1 = (k1 + 0xBB67AE85) & 0xFFFFFFFF
+    # Exactly representable float32 lattice in [0,1), like torch.rand.
+    seeded = (c0 >> 8).to(torch.float32) * (2.0 ** -24)
+    return torch.where(seeds[:, None] >= 0, seeded, stock)
