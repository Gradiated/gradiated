#!/usr/bin/env bash
set -euo pipefail
root="${GRADIATED_RUNTIME_ROOT:?}"
export CUDA_VISIBLE_DEVICES="${NVIDIA_VISIBLE_DEVICES:?Host agent must assign a GPU UUID}"
export CUDA_HOME="$root/python/lib/python3.12/site-packages/nvidia/cu13"
export CUDA_PATH="$CUDA_HOME"
export PATH="$root/python/bin:$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Triton compiles a CUDA helper at engine start and needs the Python headers.
export CPATH="$root/python/include/python3.12${CPATH:+:$CPATH}"
unset PYTHONPATH PYTHONHOME LD_PRELOAD FLASHINFER_CUBIN_CHECKSUM_DISABLED
export SGLANG_ENABLE_HEALTH_ENDPOINT_GENERATION=0
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=8
cache="${XDG_CACHE_HOME:-$HOME/.cache}/linden-sglang"
export FLASHINFER_WORKSPACE_BASE="$cache/flashinfer"
# FlashInfer loads its TRT-LLM kernels from here; the bundled, checksummed copies are seeded before every start.
export FLASHINFER_CUBIN_DIR="$cache/flashinfer-cubins/0.6.18"
export SGLANG_CACHE_DIR="$cache/sglang"
export SGLANG_JIT_CACHE_DIR="$cache/jit"
export TORCH_EXTENSIONS_DIR="$cache/torch-extensions"
export CUDA_CACHE_PATH="$cache/cuda"
mkdir -p "$FLASHINFER_WORKSPACE_BASE" "$SGLANG_CACHE_DIR" "$SGLANG_JIT_CACHE_DIR" "$TORCH_EXTENSIONS_DIR" "$CUDA_CACHE_PATH"
"$root/python/bin/python3" "$root/artifact-cache.py" "$root" "$FLASHINFER_CUBIN_DIR"
# Serving precision is a property of this bundle, so each pinned digest serves exactly one: none (BF16) or fp8.
export LINDEN_QUANTIZATION=none
exec "$root/python/bin/python3" "$root/service.py" --port "${RUNTIME_PORT:?}"
