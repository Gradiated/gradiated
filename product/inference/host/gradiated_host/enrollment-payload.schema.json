{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "type": "number", "const": 1 },
    "instance_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "management_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "auth_key": {
      "type": "string",
      "pattern": "^tskey-auth-[A-Za-z0-9-]{1,200}$"
    },
    "api_endpoint": {
      "type": "string",
      "pattern": "^100\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"
    },
    "host_bundle": {
      "type": "object",
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "base_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "url": { "type": "string", "pattern": "^https:\\/\\/[^\\s]{1,4096}$" }
      },
      "required": ["sha256", "base_id", "url"],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "instance_id",
    "management_token",
    "auth_key",
    "api_endpoint",
    "host_bundle"
  ],
  "additionalProperties": false
}
