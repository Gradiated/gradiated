new file mode 100644
index 000000000..f9347d6b4
--- /dev/null
+++ b/vllm/models/glm5next/nvidia/dspark.py
@@ -0,0 +1,250 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GLM-5.3 Flash DSpark drafter.
+
+This is the GLM-native bridge for the generic v1 DSpark speculator. It reuses
+the checkpoint's MTP block as the parallel backbone and adds a low-rank Markov
+logit bias sampled left-to-right inside each speculative block.
+
+The implementation intentionally keeps the MTP block count at the value in the
+GLM checkpoint (normally one). A trained DSpark checkpoint can add Markov-head
+weights without changing the serving engine; missing Markov weights are
+zero-initialized, making the initial arm a safe MTP-backbone control.
+"""
+from collections.abc import Iterable
+
+import torch
+import torch.nn as nn
+
+from vllm.config import VllmConfig
+from vllm.model_executor.layers.logits_processor import LogitsProcessor
+from vllm.model_executor.layers.vocab_parallel_embedding import ParallelLMHead
+from vllm.model_executor.model_loader.weight_utils import default_weight_loader
+from vllm.model_executor.models.utils import maybe_prefix
+
+from .mtp import Glm5NextMTP
+from .ops.fused_eh_norm import fused_eh_norm
+
+
+class Glm5NextDSparkForCausalLM(Glm5NextMTP):
+    """GLM MTP backbone with DSpark-compatible hooks."""
+
+    has_own_embed_tokens = False
+    has_own_lm_head = False
+    draft_id_to_target_id = None
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        draft_config = vllm_config.model_config.hf_config
+        if getattr(draft_config, "model_type", None) == "speculators":
+            target = vllm_config.speculative_config.target_model_config.hf_config
+            vllm_config.model_config.hf_config = getattr(target, "text_config", target)
+        elif hasattr(draft_config, "transformer_layer_config"):
+            vllm_config.model_config.hf_config = draft_config.transformer_layer_config
+        super().__init__(vllm_config=vllm_config, prefix=prefix)
+
+        config = self.config
+        rank = int(getattr(config, "markov_rank", 256))
+        self.markov_w1 = nn.Embedding(config.vocab_size, rank)
+        self.markov_w2 = ParallelLMHead(
+            config.vocab_size,
+            rank,
+            bias=False,
+            prefix=maybe_prefix(prefix, "markov_head.markov_w2"),
+            disable_tp=True,
+        )
+        self.markov_logits_processor = LogitsProcessor(config.vocab_size)
+        self.model.confidence_head = None
+        with torch.no_grad():
+            self.markov_w1.weight.zero_()
+            self.markov_w2.weight.zero_()
+
+        max_tokens = vllm_config.scheduler_config.max_num_batched_tokens
+        self._query_prev_hidden = torch.zeros(
+            max_tokens,
+            config.hidden_size,
+            dtype=vllm_config.model_config.dtype,
+            device=vllm_config.device_config.device,
+        )
+        self._context_input_ids: torch.Tensor | None = None
+
+    @property
+    def _mtp_layer(self):
+        return self.model._mtp_layers[0]
+
+    @property
+    def _draft_attn(self):
+        return self._mtp_layer.mtp_block.self_attn.mla_attn.mla_attn
+
+    def set_dspark_state(
+        self,
+        target_hidden: torch.Tensor,
+        last_token_indices: torch.Tensor,
+        num_query_per_req: int,
+    ) -> None:
+        """Prepare request anchor states for the captured query forward."""
+        nreq = last_token_indices.numel()
+        anchors = target_hidden.index_select(0, last_token_indices[:nreq])
+        nquery = nreq * num_query_per_req
+        self._query_prev_hidden[:nquery].copy_(
+            anchors.repeat_interleave(num_query_per_req, dim=0)
+        )
+        self._query_prev_hidden[nquery:].zero_()
+
+    def set_dspark_context_input_ids(self, input_ids: torch.Tensor) -> None:
+        self._context_input_ids = input_ids
+
+    def combine_hidden_states(self, aux_hidden_states: torch.Tensor) -> torch.Tensor:
+        """Combine target auxiliary states into the GLM MTP previous state."""
+        hidden = self.config.hidden_size
+        if aux_hidden_states.shape[-1] == hidden:
+            return aux_hidden_states
+        if aux_hidden_states.shape[-1] % hidden != 0:
+            raise ValueError(
+                "GLM DSpark auxiliary hidden state width must be a multiple of "
+                f"hidden_size={hidden}, got {aux_hidden_states.shape[-1]}"
+            )
+        return aux_hidden_states.view(
+            -1, aux_hidden_states.shape[-1] // hidden, hidden
+        ).mean(1)
+
+    def get_draft_kv_cache_layer_names(self) -> list[str]:
+        return [self._draft_attn.layer_name]
+
+    def get_draft_attn_causal(self) -> list[bool]:
+        return [True]
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return self.model.embed_input_ids(input_ids)
+
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        inputs_embeds: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        n = input_ids.shape[0] if inputs_embeds is None else inputs_embeds.shape[0]
+        if n > self._query_prev_hidden.shape[0]:
+            raise ValueError(f"GLM DSpark query length {n} exceeds preallocated buffer")
+        hidden, _ = self.model(
+            input_ids,
+            positions,
+            self._query_prev_hidden[:n],
+            inputs_embeds,
+            0,
+        )
+        return hidden
+
+    @torch.inference_mode()
+    def precompute_and_store_context_kv(
+        self,
+        context_states: torch.Tensor,
+        context_positions: torch.Tensor,
+        context_slot_mappings: list[torch.Tensor | None] | torch.Tensor | None = None,
+    ) -> None:
+        """Project MTP context K/V and write it to the draft MLA cache."""
+        if context_slot_mappings is None:
+            slot_mapping = None
+        elif isinstance(context_slot_mappings, (list, tuple)):
+            slot_mapping = context_slot_mappings[0]
+        else:
+            slot_mapping = context_slot_mappings
+
+        if self._context_input_ids is None:
+            input_ids = torch.zeros(
+                context_states.shape[0], dtype=torch.int32, device=context_states.device
+            )
+        else:
+            input_ids = self._context_input_ids[: context_states.shape[0]]
+        layer = self._mtp_layer
+        embeds = self.model.embed_tokens(input_ids)
+        eh = fused_eh_norm(
+            context_positions,
+            embeds,
+            context_states,
+            layer.enorm.weight,
+            layer.hnorm.weight,
+            layer.enorm.variance_epsilon,
+        )
+        hidden = layer.eh_proj(eh)
+        hidden = layer.mtp_block.input_layernorm(hidden)
+
+        wrapper = layer.mtp_block.self_attn
+        attn = wrapper.mla_attn.mla_attn
+        qkv_lora = wrapper.fused_qkv_a_proj(hidden)[0]
+        _, kv_lora = qkv_lora.split(
+            [wrapper.q_lora_rank, wrapper.kv_lora_rank + wrapper.qk_rope_head_dim],
+            dim=-1,
+        )
+        kv_c, k_pe = kv_lora.split(
+            [wrapper.kv_lora_rank, wrapper.qk_rope_head_dim], dim=-1
+        )
+        kv_c_normed = wrapper.kv_a_layernorm(kv_c)
+        k_pe = k_pe.unsqueeze(1)
+        if wrapper.rotary_emb is not None:
+            q_dummy = torch.zeros_like(k_pe)
+            _, k_pe = wrapper.rotary_emb(context_positions, q_dummy, k_pe)
+
+        if slot_mapping is None:
+            return
+        attn.impl.do_kv_cache_update(
+            kv_c_normed,
+            k_pe,
+            attn.kv_cache,
+            slot_mapping,
+            attn.kv_cache_dtype,
+            attn._k_scale,
+        )
+
+    def compute_draft_logits(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return self.model.compute_logits(hidden_states, 0)
+
+    def apply_markov_bias_gathered(
+        self,
+        markov_embed: torch.Tensor,
+        logits: torch.Tensor,
+        values: torch.Tensor,
+        index: torch.Tensor,
+    ) -> torch.Tensor:
+        weight = self.markov_w2.weight[index]
+        corrected = values.unsqueeze(-1)
+        corrected.baddbmm_(
+            weight,
+            markov_embed.unsqueeze(-1),
+            beta=1.0,
+            alpha=self.markov_logits_processor.scale,
+        )
+        return logits.scatter_(1, index, corrected.squeeze(-1))
+
+    def compute_logits(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return self.compute_draft_logits(hidden_states)
+
+    def map_draft_to_target(self, draft_ids: torch.Tensor) -> torch.Tensor:
+        return draft_ids
+
+    def markov_embed(self, token_ids: torch.Tensor) -> torch.Tensor:
+        return self.markov_w1(token_ids)
+
+    def markov_bias(self, markov_embed: torch.Tensor) -> torch.Tensor:
+        return self.markov_logits_processor(self.markov_w2, markov_embed)
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]):
+        # Existing GLM MTP weights are loaded by the mature loader. DSpark
+        # checkpoints may additionally carry markov_head.{markov_w1,markov_w2}.
+        markov_weights: list[tuple[str, torch.Tensor]] = []
+
+        def mtp_weights():
+            for name, value in weights:
+                if name.startswith("markov_head."):
+                    markov_weights.append((name, value))
+                else:
+                    yield name, value
+
+        loaded = super().load_weights(mtp_weights())
+        params = dict(self.named_parameters())
+        for name, value in markov_weights:
+            mapped = name.replace("markov_head.", "")
+            if mapped not in params:
+                continue
+            param = params[mapped]
+            getattr(param, "weight_loader", default_weight_loader)(param, value)
+            loaded.add(mapped)
