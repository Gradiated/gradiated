worker_processes 1;
pid /tmp/gradiated-runtime-proxy.pid;
error_log stderr warn;
events { worker_connections 2048; }
http {
    access_log off;
    client_max_body_size 32M;
    client_body_temp_path /tmp/gradiated-proxy-body;
    proxy_temp_path /tmp/gradiated-proxy-temp;
    fastcgi_temp_path /tmp/gradiated-proxy-fastcgi;
    uwsgi_temp_path /tmp/gradiated-proxy-uwsgi;
    scgi_temp_path /tmp/gradiated-proxy-scgi;
    map_hash_bucket_size 512;
    map $http_authorization $authorized {
        default 0;
        "Bearer __RUNTIME_TOKEN__" 1;
    }
    server {
        listen 8888;
        if ($authorized = 0) { return 401; }
        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Authorization "";
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 330s;
            proxy_send_timeout 330s;
        }
    }
}
