{
  "name": "@gradiated/product",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check && pnpm check:scripts && pnpm format:check",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "dev": "node scripts/free-dev-ports.mjs 3000 3001 3002 30000 && mprocs",
    "dev:forward": "node scripts/dev-forward.mjs",
    "dev:services": "turbo run dev",
    "e2e:kev": "tsx scripts/run-kev-gateway-e2e.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:generate": "turbo run openapi:generate && turbo run api:generate",
    "smoke:gateway": "node scripts/smoke-gateway-local.mjs",
    "smoke:gateway:openai": "node scripts/smoke-gateway-openai.mjs",
    "test:kev-sdk": "vitest run --config scripts/vitest.kev-sdk.config.mts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.15.0",
    "@typesafe-ai/sdk": "0.6.0",
    "drizzle-kit": "0.31.10",
    "mprocs": "0.9.6",
    "openai": "^7.5.0",
    "prettier": "^3.6.0",
    "redis": "5.8.2",
    "tsx": "4.23.12",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
