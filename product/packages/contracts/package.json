{
  "name": "@gradiated/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model-catalog": {
      "types": "./dist/model-catalog.d.ts",
      "default": "./dist/model-catalog.js"
    },
    "./training-stages": {
      "types": "./dist/training-stages.d.ts",
      "default": "./dist/training-stages.js"
    },
