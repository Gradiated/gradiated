      "types": "./dist/training-schedule.d.ts",
      "default": "./dist/training-schedule.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.0",
    "cron-parser": "5.4.0",
    "zod": "4.6.5"
