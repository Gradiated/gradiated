{
  "name": "@gradiated/control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema/index.d.ts",
      "default": "./dist/db/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && vitest run",
    "clickhouse:migrate": "node --import tsx src/clickhouse/migrate.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "pnpm --filter @gradiated/contracts build && node --import tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1135.0",
    "@aws-sdk/client-rds": "3.1135.0",
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/client-secrets-manager": "3.1135.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@clickhouse/client": "1.23.1",
    "@gradiated/contracts": "workspace:*",
    "@gradiated/temporal": "workspace:*",
    "drizzle-orm": "0.45.2",
    "free-email-domains": "1.12.19",
    "pg": "8.23.0",
    "stripe": "22.5.0",
    "uuid": "14.0.1",
    "zod": "4.6.6"
  }
}
