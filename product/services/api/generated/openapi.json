{
  "openapi": "3.1.0",
  "info": {
    "title": "Gradiated Product API",
    "version": "0.1.0",
    "description": "Application API for Gradiated exact-model inference."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current origin"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Process health and readiness."
    },
    {
      "name": "Session",
      "description": "Current human session context."
    },
    {
      "name": "Organizations",
      "description": "Customer organization lifecycle."
    },
    {
      "name": "Workspaces",
      "description": "Usage and policy boundaries."
    },
    {
      "name": "API keys",
      "description": "Direct inference credentials."
    },
    {
      "name": "Models",
      "description": "Advertised exact-model catalog."
    },
    {
      "name": "Billing",
      "description": "Balances and durable movements."
    }
  ],
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "ready",
              "not_ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Readiness": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HealthStatus"
          },
          {
            "type": "object",
            "properties": {
              "checks": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down"
                  ]
                }
              }
            },
            "required": [
              "checks"
            ]
          }
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "example": "https://gradiated.com/problems/validation"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 500
                },
                "message": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "path",
                "message"
              ]
            },
            "maxItems": 100
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "request_id"
        ]
      },
      "ModelList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "Model": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "properties": {
            "$ref": "#/components/schemas/ModelProperties"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "properties",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "ModelProperties": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "released_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "hugging_face_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "quantization": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "tokenizer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "input_modalities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "text"
                  ]
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "output_modalities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "text"
                  ]
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "pricing": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelPricingEntry"
            },
            "minItems": 1
          },
          "capacity": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelCapacityEntry"
            },
            "minItems": 1
          },
          "passthrough_parameters": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelParameterDescriptor"
            }
          },
          "deprecation_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "is_free": {
            "type": "boolean",
            "default": false
          },
          "discount_to_user": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1,
            "default": 0
          },
          "openrouter": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "slug"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "description",
          "released_at",
          "hugging_face_id",
          "quantization",
          "tokenizer",
          "input_modalities",
          "output_modalities",
          "pricing",
          "capacity",
          "passthrough_parameters",
          "deprecation_at",
          "openrouter"
        ],
        "additionalProperties": false
      },
      "ModelPricingEntry": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "enum": [
              "input_token",
              "output_token"
            ]
          },
          "cost": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "unit",
          "cost"
        ],
        "additionalProperties": false
      },
      "ModelCapacityEntry": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "context_tokens",
              "max_output_tokens"
            ]
          },
          "value": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "metric",
          "value"
        ],
        "additionalProperties": false
      },
      "ModelParameterDescriptor": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "boolean",
              "integer",
              "number",
              "string"
            ]
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "BillingAccount": {
        "type": "object",
        "properties": {
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "mode": {
            "type": "string",
            "enum": [
              "prepaid",
              "invoiced"
            ]
          },
          "balance": {
            "type": "string",
            "pattern": "^-?\\d+$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          }
        },
        "required": [
          "organization_id",
          "mode",
          "balance",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "BalanceTransactionList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BalanceTransaction"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "BalanceTransaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "type": {
            "type": "string",
            "enum": [
              "topup",
              "usage",
              "refund",
              "chargeback",
              "credit",
              "payment",
              "adjustment"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+$"
          },
          "balance_after": {
            "type": "string",
            "pattern": "^-?\\d+$"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "stripe_checkout_session",
              "stripe_refund",
              "stripe_dispute",
              "generation_settlement_batch",
              "openrouter_payment",
              "operator"
            ]
          },
          "period_start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "period_end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "generation_count": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "organization_id",
          "type",
          "amount",
          "balance_after",
          "source_type",
          "period_start",
          "period_end",
          "generation_count",
          "created_at"
        ],
        "additionalProperties": false
      },
      "TopUpCheckout": {
        "type": "object",
        "properties": {
          "checkout_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "checkout_url"
        ],
        "additionalProperties": false
      },
      "CreateTopUpCheckout": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+$",
            "description": "The top-up amount in integer nano-USD.",
            "example": "50000000000"
          }
        },
        "required": [
          "amount"
        ],
        "additionalProperties": false
      },
      "StripeWebhookResponse": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "received"
        ],
        "additionalProperties": false
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "email_verified": {
            "type": "boolean"
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrentOrganization"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "email_verified",
          "image_url",
          "created_at",
          "organizations"
        ]
      },
      "CurrentOrganization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "billing",
              "member"
            ]
          },
          "default_workspace_id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "role",
          "default_workspace_id"
        ]
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "kind": {
            "type": "string",
            "enum": [
              "customer"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "owner"
            ]
          },
          "default_workspace_id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "status",
          "role",
          "default_workspace_id",
          "created_at",
          "updated_at"
        ]
      },
      "CreateOrganization": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "WorkspaceList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "next_cursor"
        ]
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "is_default": {
            "type": "boolean"
          },
          "archived_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "organization_id",
          "name",
          "is_default",
          "archived_at",
          "created_at",
          "updated_at"
        ]
      },
      "CreateWorkspace": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "ApiKeyList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiKey"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "next_cursor"
        ]
      },
      "ApiKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "example": "0198ae50-94d8-7d4d-a8be-9f9b44b8c774"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "organization_id",
          "workspace_id",
          "name",
          "expires_at",
          "revoked_at",
          "created_by",
          "created_at",
          "updated_at"
        ]
      },
      "CreatedApiKey": {
        "type": "object",
        "properties": {
          "api_key": {
            "$ref": "#/components/schemas/ApiKey"
          },
          "secret": {
            "type": "string",
            "pattern": "^grad_[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "api_key",
          "secret"
        ]
      },
      "CreateApiKey": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-08-16T12:00:00.000Z"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "The API process is live.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "The API is ready to serve product traffic.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "At least one required dependency is unavailable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "operationId": "listModels",
