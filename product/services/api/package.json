{
  "name": "@gradiated/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && vitest run",
    "configure:deepseek-v4-flash": "node dist/operations/configure-deepseek-v4-flash.js",
    "configure:gemma4": "node dist/operations/configure-gemma4.js",
    "configure:glm-5-3-flash": "node dist/operations/configure-glm-5-3-flash.js",
    "configure:kev-9b": "node dist/operations/configure-kev-9b.js",
    "configure:openrouter": "node dist/operations/configure-openrouter.js",
    "dev": "tsx watch src/server.ts",
    "instance:register": "node dist/operations/register-instance.js",
    "openapi:check": "node --import tsx scripts/generate-openapi.ts --check",
    "openapi:generate": "node --import tsx scripts/generate-openapi.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@gradiated/config": "workspace:*",
    "@gradiated/contracts": "workspace:*",
    "@gradiated/control": "workspace:*",
    "@gradiated/valkey": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.0",
    "@peculiar/x509": "2.1.0",
    "@scalar/hono-api-reference": "0.11.14",
    "better-auth": "1.6.29",
    "hono": "4.13.2",
    "prom-client": "15.1.3",
    "redis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "stripe": "22.5.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "yaml": "2.9.0"
  }
}
