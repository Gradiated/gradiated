{
  "name": "@gradiated/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "openapi-typescript ../api/generated/openapi.json -o src/api/schema.ts && prettier --write src/api/schema.ts",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dev": "vite --host 127.0.0.1",
    "test:e2e": "pnpm --workspace-root turbo run build --filter=@gradiated/api --env-mode=loose && docker compose -f ../../docker-compose.yml up -d && docker compose -f ../../docker-compose.yml wait valkey-cluster-init && docker compose -f ../../docker-compose.yml up -d --wait postgres valkey clickhouse && DATABASE_URL=postgresql://gradiated:gradiated@127.0.0.1:5432/gradiated pnpm --filter @gradiated/control db:migrate && playwright test"
  },
  "dependencies": {
    "@ebay/nice-modal-react": "^1.2.13",
    "@hookform/resolvers": "latest",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "better-auth": "1.6.29",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "date-fns": "^4.4.0",
    "lucide-react": "latest",
    "openapi-fetch": "latest",
    "react": "latest",
    "react-day-picker": "^10.0.1",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@gradiated/control": "workspace:*",
    "@gradiated/valkey": "workspace:*",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "openapi-typescript": "latest",
    "tailwindcss": "latest",
    "typescript": "5.9.3",
    "vite": "latest"
  }
}
