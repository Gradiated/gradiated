{
  "name": "@gradiated/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "openapi-typescript ../api/generated/client-openapi.json -o src/api/schema.ts && prettier --write src/api/schema.ts",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tests/tsconfig.json --noEmit && vitest run --config tests/vitest.config.ts",
    "dev": "vite --host 127.0.0.1",
    "test:e2e": "pnpm --workspace-root turbo run build --filter=@gradiated/api --env-mode=loose && docker compose -f ../../docker-compose.yml up -d && docker compose -f ../../docker-compose.yml wait valkey-cluster-init && docker compose -f ../../docker-compose.yml up -d --wait postgres valkey clickhouse && DATABASE_URL=postgresql://gradiated:gradiated@127.0.0.1:5432/gradiated pnpm --filter @gradiated/control db:migrate && playwright test",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "screenshots": "pnpm build-storybook && uv run --locked --project ../../../tools/browser python ../../../tools/browser/storybook_screenshots.py"
  },
  "dependencies": {
    "@ebay/nice-modal-react": "^1.2.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@gradiated/analytics": "workspace:*",
    "@gradiated/contracts": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "highlight.js": "11.11.2",
    "lucide-react": "1.47.0",
    "openapi-fetch": "0.17.0",
    "posthog-js": "^1.430.2",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@gradiated/control": "workspace:*",
    "@gradiated/valkey": "workspace:*",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "openapi-typescript": "7.13.0",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
