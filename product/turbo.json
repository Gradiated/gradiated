{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["RUSTUP_TOOLCHAIN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "api:generate": {
      "cache": false,
      "outputs": ["src/api/schema.ts"]
    },
    "check": {
      "dependsOn": ["^build", "openapi:check"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "openapi:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "openapi:generate": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
