VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server-side only, read by the Vercel functions in api/ (jobsRead + candidatesWrite).
ASHBY_API_KEY=

# Server-side only. Slack incoming webhook for the private model naming review channel.
MODEL_NAME_SLACK_WEBHOOK_URL=

# Server-side only. Upstash Redis for roadmap upvote totals (added by Vercel's
# Upstash integration; UPSTASH_REDIS_REST_URL/TOKEN names also work).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Server-side only. Vercel sends it to the daily roadmap summary cron
# (api/roadmap-digest.ts); any long random string.
CRON_SECRET=
