{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . && node scripts/ashby-jobs-unchanged.ts",
  "trailingSlash": true,
  "redirects": [
    { "source": "/hardware", "destination": "/", "permanent": true },
    { "source": "/hardware/", "destination": "/", "permanent": true },
    {
      "source": "/library/",
      "has": [
        {
          "type": "query",
          "key": "show",
          "value": "(?:methods|handbook)"
        }
      ],
      "destination": "/handbook/",
      "permanent": true
    },
    {
      "source": "/methods/",
      "destination": "/handbook/",
      "permanent": true
    },
    {
      "source": "/methods/:slug/",
      "destination": "/handbook/:slug/",
      "permanent": true
    },
    {
      "source": "/library/method/:slug/",
      "destination": "/handbook/:slug/",
      "permanent": true
    },
    {
      "source": "/subprocessors-security/",
      "destination": "/subprocessors/",
      "permanent": true
    },
    {
      "source": "/library/how-to-get-an-answer-out-of-sand/",
      "destination": "/library/sand-to-thought/how-to-get-an-answer-out-of-sand/",
      "permanent": true
    },
    {
      "source": "/sand-to-thought/",
      "destination": "/library/sand-to-thought/how-to-get-an-answer-out-of-sand/",
      "permanent": true
    },
    {
      "source": "/sand-to-thought/fabricating-a-transistor/",
      "destination": "/library/sand-to-thought/fabricating-a-transistor/",
      "permanent": true
    },
    {
      "source": "/sand-to-thought/library/",
      "destination": "/library/sand-to-thought/",
      "permanent": true
    },
    {
      "source": "/notes/working-with-us/",
      "destination": "/careers/",
      "permanent": true
    },
    {
      "source": "/notes/",
      "destination": "/library/",
      "permanent": true
    },
    {
      "source": "/notes/:slug/",
      "destination": "/library/:slug/",
      "permanent": true
    },
    {
      "source": "/docs/api/",
      "destination": "/docs/api-reference/",
      "permanent": true
    },
    {
      "source": "/docs/api-keys/",
      "destination": "/docs/quickstart/",
      "permanent": true
    },
    {
      "source": "/docs/billing/",
      "destination": "/docs/errors/",
      "permanent": true
    },
    {
      "source": "/docs/migrate/",
      "destination": "/docs/quickstart/",
      "permanent": true
    },
    {
      "source": "/docs/usage/",
      "destination": "/docs/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/style/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/style/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/docs/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
