#!/usr/bin/env python3

import argparse
import hashlib
import json
import os
import pathlib
import shutil
import sys
import tarfile
import tempfile


def sha256(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fail(message: str) -> int:
    print(json.dumps({"error": message}, sort_keys=True), file=sys.stderr)
    return 2


def extract(args: argparse.Namespace) -> int:
    archive = pathlib.Path(args.archive).resolve()
    root = pathlib.Path(args.root).resolve()
    if not archive.is_file():
        return fail("archive_missing")
    root.mkdir(parents=True, exist_ok=True)
    digest = sha256(archive)
    destination = root / digest
    marker = destination / ".archive.sha256"
    if destination.exists():
        if marker.is_file() and marker.read_text().strip() == digest:
            print(
                json.dumps(
                    {
                        "archive_sha256": digest,
                        "destination": str(destination),
                        "idempotent": True,
                    },
                    sort_keys=True,
                )
            )
            return 0
        return fail("snapshot_destination_conflict")

    temporary = pathlib.Path(
        tempfile.mkdtemp(prefix=f".{digest}.", dir=root)
    )
    try:
        with tarfile.open(archive, "r:*") as bundle:
            bundle.extractall(temporary, filter="data")
        (temporary / ".archive.sha256").write_text(digest + "\n")
        try:
            os.replace(temporary, destination)
        except FileExistsError:
            if marker.is_file() and marker.read_text().strip() == digest:
                shutil.rmtree(temporary)
            else:
                shutil.rmtree(temporary)
                return fail("snapshot_destination_conflict")
    except Exception:
        shutil.rmtree(temporary, ignore_errors=True)
        raise

    print(
        json.dumps(
            {
                "archive_sha256": digest,
                "destination": str(destination),
                "idempotent": False,
            },
            sort_keys=True,
        )
    )
    return 0


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description=(
            "Extract a retrieved tar archive into an immutable, "
            "content-addressed snapshot directory."
        )
    )
    root.add_argument("--archive", required=True)
    root.add_argument("--root", required=True)
    root.set_defaults(run=extract)
    return root


def main() -> int:
    args = parser().parse_args()
    return args.run(args)


if __name__ == "__main__":
    raise SystemExit(main())
