#!/usr/bin/env python3

import argparse
import hashlib
import json
import os
import pathlib
import stat
import sys
import tarfile
import tempfile


class PackError(Exception):
    pass


def sha256(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fail(message: str) -> int:
    print(json.dumps({"error": message}, sort_keys=True), file=sys.stderr)
    return 2


def safe_relative_path(value: object) -> pathlib.PurePosixPath:
    if not isinstance(value, str) or not value:
        raise PackError("manifest_path_invalid")
    path = pathlib.PurePosixPath(value)
    if (
        path.is_absolute()
        or path.as_posix() != value
        or "\\" in value
        or any(part in ("", ".", "..") for part in path.parts)
    ):
        raise PackError(f"manifest_path_unsafe:{value}")
    return path


def manifest_rows(value: object) -> list[dict[str, object]]:
    if not isinstance(value, dict):
        raise PackError("manifest_not_object")
    files = value.get("files")
    if isinstance(files, list):
        rows = files
    elif value and all(
        isinstance(path, str)
        and isinstance(metadata, dict)
        and "sha256" in metadata
        for path, metadata in value.items()
    ):
        rows = [
            {"path": path, **metadata}
            for path, metadata in value.items()
        ]
    else:
        raise PackError("manifest_files_invalid")
    if not all(isinstance(row, dict) for row in rows):
        raise PackError("manifest_row_invalid")
    return rows


def resolve_member(
    root: pathlib.Path, relative: pathlib.PurePosixPath
) -> pathlib.Path:
    candidate = root.joinpath(*relative.parts)
    current = root
    for part in relative.parts:
        current = current / part
        if current.is_symlink():
            raise PackError(f"manifest_member_symlink:{relative}")
    resolved = candidate.resolve()
    try:
        resolved.relative_to(root)
    except ValueError as error:
        raise PackError(f"manifest_path_outside_root:{relative}") from error
    if not resolved.is_file():
        raise PackError(f"manifest_member_missing_or_not_file:{relative}")
    return resolved


def validated_members(
    root: pathlib.Path,
    manifest: pathlib.Path,
) -> list[tuple[pathlib.PurePosixPath, pathlib.Path]]:
    try:
        manifest_relative = pathlib.PurePosixPath(
            manifest.relative_to(root).as_posix()
        )
    except ValueError as error:
        raise PackError("manifest_outside_root") from error
    rows = manifest_rows(json.loads(manifest.read_text()))
    members: dict[str, tuple[pathlib.PurePosixPath, pathlib.Path]] = {
        manifest_relative.as_posix(): (manifest_relative, manifest)
    }
    for row in rows:
        relative = safe_relative_path(row.get("path"))
        key = relative.as_posix()
        if key in members:
            raise PackError(f"manifest_duplicate_path:{key}")
        member = resolve_member(root, relative)
        expected_bytes = row.get("bytes")
        if expected_bytes is not None and (
            not isinstance(expected_bytes, int)
            or member.stat().st_size != expected_bytes
        ):
            raise PackError(f"manifest_size_mismatch:{key}")
        expected_hash = row.get("sha256")
        if not isinstance(expected_hash, str) or sha256(member) != expected_hash:
            raise PackError(f"manifest_hash_mismatch:{key}")
        members[key] = (relative, member)
    return [members[key] for key in sorted(members)]


def add_file(
    bundle: tarfile.TarFile,
    relative: pathlib.PurePosixPath,
    path: pathlib.Path,
) -> None:
    info = tarfile.TarInfo(relative.as_posix())
    info.size = path.stat().st_size
    info.mode = stat.S_IMODE(path.stat().st_mode)
    info.mtime = 0
    info.uid = 0
    info.gid = 0
    info.uname = ""
    info.gname = ""
    with path.open("rb") as handle:
        bundle.addfile(info, handle)


def pack(args: argparse.Namespace) -> int:
    root = pathlib.Path(args.root).resolve()
    manifest = pathlib.Path(args.manifest).resolve()
    archive = pathlib.Path(args.archive).resolve()
    if not root.is_dir():
        return fail("root_missing_or_not_directory")
    if not manifest.is_file():
        return fail("manifest_missing_or_not_file")
    try:
        members = validated_members(root, manifest)
    except (PackError, json.JSONDecodeError, OSError) as error:
        return fail(str(error))

    archive.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{archive.name}.", dir=archive.parent
    )
    os.close(descriptor)
    temporary = pathlib.Path(temporary_name)
    try:
        with tarfile.open(temporary, "w") as bundle:
            for relative, path in members:
                add_file(bundle, relative, path)
        os.replace(temporary, archive)
    except Exception:
        temporary.unlink(missing_ok=True)
        raise

    print(
        json.dumps(
            {
                "archive": str(archive),
                "archive_sha256": sha256(archive),
                "file_count": len(members),
                "manifest": str(manifest),
            },
            sort_keys=True,
        )
    )
    return 0


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description=(
            "Build an exact packet tar directly from a SHA-256 manifest."
        )
    )
    root.add_argument("--root", required=True)
    root.add_argument("--manifest", required=True)
    root.add_argument("--archive", required=True)
    root.set_defaults(run=pack)
    return root


def main() -> int:
    args = parser().parse_args()
    return args.run(args)


if __name__ == "__main__":
    raise SystemExit(main())
