#!/usr/bin/env python3
"""Aligner coverage on real anonymized assistant turns.

Runs on fbf8 from a directory holding xtok_distill.py and kimi.tiktoken.model, with the
serve-env Python (it has tiktoken and tokenizers). Prints aggregates only, never text.
Usage: xtok-real-coverage <train.jsonl> <max conversations>
"""
import base64, json, statistics, sys
from collections import Counter
from pathlib import Path

HERE = Path(__file__).parent
sys.path.insert(0, str(HERE))
sys.path.insert(0, "/opt/posthog-sft/deepseek")
import encode_ds  # noqa: E402
from convert import convert_row  # noqa: E402
import tiktoken  # noqa: E402
from tokenizers import Tokenizer  # noqa: E402
from xtok_distill import ParseError, align, parse_deepseek_output, render_k3_completion  # noqa: E402

K3_PATTERN = "|".join([
    r"""[\p{Han}]+""",
    r"""[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]*[\p{Ll}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]+(?i:'s|'t|'re|'ve|'m|'ll|'d)?""",
    r"""[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]+[\p{Ll}\p{Lm}\p{Lo}\p{M}&&[^\p{Han}]]*(?i:'s|'t|'re|'ve|'m|'ll|'d)?""",
    r"""\p{N}{1,3}""", r""" ?[^\s\p{L}\p{N}]+[\r\n]*""", r"""\s*[\r\n]+""", r"""\s+(?!\S)""", r"""\s+""",
])
ranks = {}
for line in (HERE / "kimi.tiktoken.model").read_bytes().splitlines():
    if line.strip():
        tok, rank = line.split()
        ranks[base64.b64decode(tok)] = int(rank)
kimi = tiktoken.Encoding("kimi", pat_str=K3_PATTERN, mergeable_ranks=ranks, special_tokens={})
ds = Tokenizer.from_file(str(encode_ds.SNAPSHOT / "tokenizer.json"))


def teacher_offsets(rendering):
    offsets, position = [], 0
    for seg in rendering.segments:
        if seg.special:
            offsets.append((position, position + len(seg.text)))
        else:
            data, consumed, start = seg.text.encode(), 0, position
            for t in kimi.encode_ordinary(seg.text):
                consumed += len(kimi.decode_single_token_bytes(t))
                end = position + len(data[:consumed].decode(errors="ignore"))
                offsets.append((start, end))
                start = end
        position += len(seg.text)
    return offsets


path, limit = sys.argv[1], int(sys.argv[2])
stats = Counter()
per_field = Counter(), Counter()
span_sizes = []
prompt_tails = Counter()
for n, line in enumerate(open(path)):
    if n >= limit:
        break
    row = json.loads(line)
    try:
        messages, tools = convert_row(row)
    except Exception as e:  # noqa: BLE001
        stats[f"convert_error:{type(e).__name__}"] += 1
        continue
    msgs = encode_ds.to_deepseek_messages(messages, tools)
    for k, m in enumerate(msgs):
        if m["role"] != "assistant":
            continue
        prompt = encode_ds.render(msgs[:k], True)
        full = encode_ds.render(msgs[: k + 1], False)
        if not full.startswith(prompt):
            stats["not_prefix"] += 1
            continue
        prompt_tails[prompt[-24:]] += 1
        completion = full[len(prompt):]
        stats["turns"] += 1
        try:
            turn, s_fields = parse_deepseek_output(completion, thinking=False)
            rendering = render_k3_completion(turn, thinking=False)
        except (ParseError, ValueError):
            stats["parse_error"] += 1
            continue
        enc = ds.encode(completion, add_special_tokens=False)
        try:
            spans = align(enc.offsets, s_fields, teacher_offsets(rendering), rendering.fields)
        except ValueError:
            stats["length_mismatch"] += 1
            continue
        stats["calls"] += len(turn.calls)
        stats["student_tokens"] += len(enc.offsets)
        content = [i for i, (a, b) in enumerate(enc.offsets) if any(f.start <= a < b <= f.end for f in s_fields)]
        stats["content_tokens"] += len(content)
        stats["covered"] += sum(len(s.student_tokens) for s in spans)
        stats["spans"] += len(spans)
        span_sizes += [len(s.student_tokens) for s in spans]
        for f in s_fields:
            kind = f.field.split(".")[-1] if "." in f.field else f.field
            ids = [i for i, (a, b) in enumerate(enc.offsets) if f.start <= a < b <= f.end]
            per_field[0][kind] += len(ids)
            cov = {i for s in spans if s.field == f.field for i in s.student_tokens}
            per_field[1][kind] += len(cov)

print(json.dumps(dict(stats), indent=1))
print("content coverage", round(stats["covered"] / stats["content_tokens"], 4))
print("all-token coverage", round(stats["covered"] / stats["student_tokens"], 4))
print("student tokens/span mean", round(statistics.mean(span_sizes), 3), "max", max(span_sizes))
print("per field coverage", {k: (per_field[0][k], round(per_field[1][k] / per_field[0][k], 4)) for k in per_field[0] if per_field[0][k]})
print("prompt tails", [repr(t) for t, _ in prompt_tails.most_common(3)])
