+def bind_tp1_tied_embedding_dflash_head(
+    embed_tokens: nn.Embedding,
+    vocab_size: int,
+) -> nn.Embedding:
+    if get_tensor_model_parallel_world_size() != 1:
+        raise ValueError("Gemma 4 tied-head DFLASH adapter requires TP=1.")
+    if embed_tokens.weight.ndim != 2 or embed_tokens.weight.shape[0] != vocab_size:
+        raise ValueError(
+            "Gemma 4 tied-head DFLASH adapter requires an unsharded full-vocabulary "
+            f"weight: expected {vocab_size} rows, got {tuple(embed_tokens.weight.shape)}."
+        )
+    embed_tokens.shard_indices = VocabParallelEmbeddingShardIndices(
+        padded_org_vocab_start_index=0,
+        padded_org_vocab_end_index=vocab_size,
+        padded_added_vocab_start_index=vocab_size,
+        padded_added_vocab_end_index=vocab_size,
+        org_vocab_start_index=0,
+        org_vocab_end_index=vocab_size,
+        added_vocab_start_index=vocab_size,
+        added_vocab_end_index=vocab_size,
+    )
+    return embed_tokens
+
