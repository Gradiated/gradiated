#!/usr/bin/env python3

import argparse
import datetime
import fcntl
import json
import os
import pathlib
import subprocess
import sys
import tempfile
import time


def utc_now() -> str:
    return datetime.datetime.now(datetime.UTC).isoformat().replace("+00:00", "Z")


def process_identity(pid: int) -> tuple[str, int] | None:
    try:
        stat = pathlib.Path(f"/proc/{pid}/stat").read_text()
    except (FileNotFoundError, ProcessLookupError):
        return None
    fields = stat[stat.rfind(")") + 2 :].split()
    state = fields[0]
    start_ticks = int(fields[19])
    return state, start_ticks


def is_live(record: dict[str, object]) -> bool:
    identity = process_identity(int(record["pid"]))
    return (
        identity is not None
        and identity[0] != "Z"
        and identity[1] == int(record["start_ticks"])
    )


def read_record(path: pathlib.Path) -> dict[str, object]:
    return json.loads(path.read_text())


def atomic_write(path: pathlib.Path, record: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        json.dump(record, handle, indent=2, sort_keys=True)
        handle.write("\n")
        temporary = pathlib.Path(handle.name)
    os.replace(temporary, path)


def start(args: argparse.Namespace) -> int:
    state_path = pathlib.Path(args.state)
    state_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = state_path.with_name(f"{state_path.name}.lock")
    with lock_path.open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if state_path.exists():
            prior = read_record(state_path)
            if is_live(prior):
                print(
                    json.dumps({"error": "owner_already_live", **prior}),
                    file=sys.stderr,
                )
                return 2

        command = args.command
        if command and command[0] == "--":
            command = command[1:]
        if not command:
            print("detached-owner start requires a command after --", file=sys.stderr)
            return 2

        log_path = pathlib.Path(args.log).resolve()
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open("ab", buffering=0) as log:
            process = subprocess.Popen(
                command,
                cwd=args.cwd,
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
            )

        identity = None
        for _ in range(20):
            identity = process_identity(process.pid)
            if identity is not None:
                break
            time.sleep(0.01)
        if identity is None:
            print(
                "detached owner exited before its identity was recorded",
                file=sys.stderr,
            )
            return 1

        record: dict[str, object] = {
            "command": command,
            "cwd": str(pathlib.Path(args.cwd).resolve()) if args.cwd else None,
            "launched_at_utc": utc_now(),
            "log": str(log_path),
            "pid": process.pid,
            "start_ticks": identity[1],
            "unit_manager": "remote-shell",
        }
        atomic_write(state_path, record)
    print(json.dumps({"live": is_live(record), **record}, sort_keys=True))
    return 0


def status(args: argparse.Namespace) -> int:
    state_path = pathlib.Path(args.state)
    if not state_path.exists():
        print(json.dumps({"live": False, "reason": "state_missing"}))
        return 3
    record = read_record(state_path)
    live = is_live(record)
    print(json.dumps({"live": live, **record}, sort_keys=True))
    return 0 if live else 3


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description="Launch and identify a process that survives its SSH session."
    )
    commands = root.add_subparsers(dest="action", required=True)

    launch = commands.add_parser("start")
    launch.add_argument("--state", required=True)
    launch.add_argument("--log", required=True)
    launch.add_argument("--cwd")
    launch.add_argument("command", nargs=argparse.REMAINDER)
    launch.set_defaults(run=start)

    inspect = commands.add_parser("status")
    inspect.add_argument("--state", required=True)
    inspect.set_defaults(run=status)
    return root


def main() -> int:
    args = parser().parse_args()
    return args.run(args)


if __name__ == "__main__":
    raise SystemExit(main())
