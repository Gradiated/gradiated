{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-100://budget-admission/1.0.0",
  "title": "Campaign 100 pre-create budget admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "baseline_sha256", "baseline_signed_off", "reconciliation_status",
    "campaign_cap_usd", "campaign_additional_spend_usd", "phase", "phase_cumulative_cap_usd",
    "hourly_price_usd", "maximum_deadline_seconds", "recorded_maximum_deadline_cost_usd",
    "active_campaign_pod_count", "inventory_snapshot_sha256", "watchdog_contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "baseline_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_signed_off": {"const": true},
    "reconciliation_status": {"enum": ["authoritative", "conservative"]},
    "campaign_cap_usd": {"const": "100.00"},
    "campaign_additional_spend_usd": {"$ref": "#/$defs/decimal"},
    "phase": {"enum": ["B", "C", "D", "E", "F", "RESERVE"]},
    "phase_cumulative_cap_usd": {"$ref": "#/$defs/decimal"},
    "hourly_price_usd": {"$ref": "#/$defs/decimal"},
    "maximum_deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
    "recorded_maximum_deadline_cost_usd": {"$ref": "#/$defs/decimal"},
    "active_campaign_pod_count": {"const": 0},
    "inventory_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "watchdog_contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"}
  }
}
