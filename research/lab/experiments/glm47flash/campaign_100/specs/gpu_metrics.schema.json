{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-100://gpu-metrics/1.0.0",
  "title": "Campaign 100 request metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requests_scheduled", "requests_completed", "requests_slo_eligible", "requests_slo_compliant",
    "errors", "silent_truncations", "input_tokens", "output_tokens", "slo_input_tokens", "slo_output_tokens", "wall_seconds",
    "input_tokens_per_second", "output_tokens_per_second", "total_tokens_per_second",
    "completed_request_goodput_per_second", "latency_ms"
  ],
  "properties": {
    "requests_scheduled": {"type": "integer", "minimum": 0},
    "requests_completed": {"type": "integer", "minimum": 0},
    "requests_slo_eligible": {"type": "integer", "minimum": 0},
    "requests_slo_compliant": {"type": "integer", "minimum": 0},
    "errors": {"type": "integer", "minimum": 0},
    "silent_truncations": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "slo_input_tokens": {"type": "integer", "minimum": 0},
    "slo_output_tokens": {"type": "integer", "minimum": 0},
    "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
    "input_tokens_per_second": {"type": "number", "minimum": 0},
    "output_tokens_per_second": {"type": "number", "minimum": 0},
    "total_tokens_per_second": {"type": "number", "minimum": 0},
    "completed_request_goodput_per_second": {"type": "number", "minimum": 0},
    "latency_ms": {
      "type": "object", "additionalProperties": false,
      "required": ["ttft", "inter_token", "end_to_end"],
      "properties": {
        "ttft": {"$ref": "#/$defs/percentiles"},
        "inter_token": {"$ref": "#/$defs/percentiles"},
        "end_to_end": {"$ref": "#/$defs/percentiles"}
      }
    }
  },
  "$defs": {
    "percentiles": {
      "type": "object", "additionalProperties": false,
      "required": ["p50", "p95", "p99"],
      "properties": {
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "p99": {"type": "number", "minimum": 0}
      }
    }
  }
}
