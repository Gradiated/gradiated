{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-100://gpu-telemetry/1.0.0",
  "title": "Campaign 100 GPU telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["cadence_seconds", "gpu", "memory_throughput", "scheduler", "startup", "profiler", "raw_files"],
  "properties": {
    "cadence_seconds": {"type": "number", "exclusiveMinimum": 0},
    "gpu": {
      "type": "object", "additionalProperties": false,
      "required": ["utilization_percent", "vram_used_bytes", "power_watts", "temperature_celsius", "sm_clock_mhz", "memory_clock_mhz"],
      "properties": {
        "utilization_percent": {"$ref": "#/$defs/percentiles"},
        "vram_used_bytes": {"$ref": "#/$defs/percentiles"},
        "power_watts": {"$ref": "#/$defs/percentiles"},
        "temperature_celsius": {"$ref": "#/$defs/percentiles"},
        "sm_clock_mhz": {"$ref": "#/$defs/percentiles"},
        "memory_clock_mhz": {"$ref": "#/$defs/percentiles"}
      }
    },
    "memory_throughput": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "metric_name", "value", "unit"],
      "properties": {
        "status": {"enum": ["measured", "unsupported"]},
        "metric_name": {"type": ["string", "null"]},
        "value": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": ["string", "null"]}
      }
    },
    "scheduler": {
      "type": "object", "additionalProperties": false,
      "required": ["iteration_count", "batch_size", "prefill_tokens", "decode_tokens", "kv_allocated_tokens_peak", "prefix_cache_hits", "prefix_cache_misses"],
      "properties": {
        "iteration_count": {"type": "integer", "minimum": 0},
        "batch_size": {"$ref": "#/$defs/percentiles"},
        "prefill_tokens": {"type": "integer", "minimum": 0},
        "decode_tokens": {"type": "integer", "minimum": 0},
        "kv_allocated_tokens_peak": {"type": "integer", "minimum": 0},
        "prefix_cache_hits": {"type": "integer", "minimum": 0},
        "prefix_cache_misses": {"type": "integer", "minimum": 0}
      }
    },
    "startup": {
      "type": "object", "additionalProperties": false,
      "required": ["container_seconds", "model_load_seconds", "cache_allocation_seconds", "server_ready_seconds"],
      "properties": {
        "container_seconds": {"type": "number", "minimum": 0},
        "model_load_seconds": {"type": "number", "minimum": 0},
        "cache_allocation_seconds": {"type": "number", "minimum": 0},
        "server_ready_seconds": {"type": "number", "minimum": 0}
      }
    },
    "profiler": {
      "type": "object", "additionalProperties": false,
      "required": ["capture_seconds", "overhead_percent", "trace_sha256", "top_kernels"],
      "properties": {
        "capture_seconds": {"type": "number", "exclusiveMinimum": 0},
        "overhead_percent": {"type": "number", "minimum": 0},
        "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "top_kernels": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "time_share_fraction"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "time_share_fraction": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "raw_files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "kind": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "percentiles": {
      "type": "object", "additionalProperties": false,
      "required": ["p50", "p95", "p99"],
      "properties": {
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "p99": {"type": "number", "minimum": 0}
      }
    }
  }
}
