--- /dev/null
+++ b/sglang/srt/layers/attention/gemma4_attention_endpoint.py
@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+
+
+def route_attention(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    *,
+    local: bool,
+    attention_mask: torch.Tensor | None = None,
+    scale: float | None = None,
+) -> tuple[torch.Tensor, dict]:
+    original_key_elements = key.numel()
+    original_value_elements = value.numel()
+    if local:
+        backend = SDPBackend.FLASH_ATTENTION
+        enable_gqa = True
+        expanded_key = key
+        expanded_value = value
+    else:
+        backend = SDPBackend.EFFICIENT_ATTENTION
+        enable_gqa = False
+        repeats = query.shape[1] // key.shape[1]
+        expanded_key = key.repeat_interleave(repeats, dim=1)
+        expanded_value = value.repeat_interleave(repeats, dim=1)
+    with sdpa_kernel(backend):
+        output = F.scaled_dot_product_attention(
+            query,
+            expanded_key,
+            expanded_value,
+            attn_mask=attention_mask,
+            enable_gqa=enable_gqa,
+            scale=scale,
+        )
+    expanded_elements = expanded_key.numel() + expanded_value.numel()
+    source_elements = original_key_elements + original_value_elements
+    telemetry = {
+        "backend": "flash" if local else "efficient",
+        "native_gqa": local,
+        "kv_source_bytes": source_elements * key.element_size(),
+        "kv_expansion_bytes": (expanded_elements - source_elements) * key.element_size(),
+        "expanded_kv_bytes": expanded_elements * key.element_size(),
+    }
+    return output, telemetry
+
+
+def decode_attention(
+    query: torch.Tensor,
+    layer,
+    forward_batch,
+    backend,
+) -> torch.Tensor:
+    batch_size = query.shape[0]
+    local = layer.sliding_window_size is not None and layer.sliding_window_size > -1
+    maximum_context = layer.sliding_window_size if local else min(backend.max_context_len, 4572)
+    sequence_lengths = forward_batch.seq_lens[:batch_size].to(torch.long)
+    offsets = torch.arange(maximum_context, device=query.device, dtype=torch.long)
+    if local:
+        starts = torch.clamp(sequence_lengths - maximum_context, min=0)
+        positions = starts[:, None] + offsets[None, :]
+    else:
+        positions = offsets[None, :].expand(batch_size, -1)
+    valid = positions < sequence_lengths[:, None]
+    positions = torch.minimum(
+        positions, torch.clamp(sequence_lengths[:, None] - 1, min=0)
+    )
+    request_rows = forward_batch.req_pool_indices[:batch_size].to(torch.long)
+    cache_locations = backend.req_to_token[request_rows[:, None], positions]
+    pool = forward_batch.token_to_kv_pool
+    if local:
+        cache_locations = pool.translate_loc_from_full_to_swa(cache_locations)
+    key_cache = pool.get_key_buffer(layer.layer_id)
+    value_cache = pool.get_value_buffer(layer.layer_id)
+    key = key_cache[cache_locations].to(query.dtype)
+    value = value_cache[cache_locations].to(query.dtype)
+    if layer.k_scale_float is not None:
+        key = key * layer.k_scale_float
+    if layer.v_scale_float is not None:
+        value = value * layer.v_scale_float
+    key = key.permute(0, 2, 1, 3).contiguous()
+    value = value.permute(0, 2, 1, 3).contiguous()
+    query = query.reshape(
+        batch_size, layer.tp_q_head_num, 1, layer.qk_head_dim
+    )
+    attention_mask = None if local else valid[:, None, None, :]
+    output, _ = route_attention(
+        query,
+        key,
+        value,
+        local=local,
+        attention_mask=attention_mask,
+        scale=layer.scaling,
+    )
+    return output.reshape(
+        batch_size, layer.tp_q_head_num * layer.v_head_dim
+    )
