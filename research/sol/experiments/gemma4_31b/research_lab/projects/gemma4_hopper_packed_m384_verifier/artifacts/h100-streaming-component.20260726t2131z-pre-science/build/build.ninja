ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=packed_m384_streaming_2262a4a20e94 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /usr/local/lib/python3.12/dist-packages/torch/include -isystem /usr/local/lib/python3.12/dist-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /usr/include/python3.12 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -I/usr/local/lib/python3.12/dist-packages/nvidia/cublas/include -I/usr/local/lib/python3.12/dist-packages/nvidia/cuda_cupti/include -I/usr/local/lib/python3.12/dist-packages/nvidia/cuda_nvrtc/include -I/usr/local/lib/python3.12/dist-packages/nvidia/cuda_runtime/include -I/usr/local/lib/python3.12/dist-packages/nvidia/cudnn/include -I/usr/local/lib/python3.12/dist-packages/nvidia/cufft/include -I/usr/local/lib/python3.12/dist-packages/nvidia/cufile/include -I/usr/local/lib/python3.12/dist-packages/nvidia/curand/include -I/usr/local/lib/python3.12/dist-packages/nvidia/cusolver/include -I/usr/local/lib/python3.12/dist-packages/nvidia/cusparse/include -I/usr/local/lib/python3.12/dist-packages/nvidia/cusparselt/include -I/usr/local/lib/python3.12/dist-packages/nvidia/nccl/include -I/usr/local/lib/python3.12/dist-packages/nvidia/nvjitlink/include -I/usr/local/lib/python3.12/dist-packages/nvidia/nvshmem/include -I/usr/local/lib/python3.12/dist-packages/nvidia/nvtx/include -DTORCH_EXTENSION_NAME=packed_m384_streaming_2262a4a20e94 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /usr/local/lib/python3.12/dist-packages/torch/include -isystem /usr/local/lib/python3.12/dist-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /usr/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options '-fPIC' -O3 -lineinfo -arch=sm_90a -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/usr/local/lib/python3.12/dist-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build packed_m384_streaming_cluster.cuda.o: cuda_compile /project/packed_m384_streaming_cluster.cu





build packed_m384_streaming_2262a4a20e94.so: link packed_m384_streaming_cluster.cuda.o

default packed_m384_streaming_2262a4a20e94.so
