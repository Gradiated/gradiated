diff --git a/vllm/model_executor/layers/fusion/quant_activation.py b/vllm/model_executor/layers/fusion/quant_activation.py
index 4be2f4f9f..42dd544bd 100644
--- a/vllm/model_executor/layers/fusion/quant_activation.py
+++ b/vllm/model_executor/layers/fusion/quant_activation.py
@@ -14,0 +15,3 @@ import torch
+from vllm import _custom_ops as ops
+from vllm import envs
+from vllm.model_executor.layers.layernorm import RMSNorm
@@ -15,0 +19,3 @@ from vllm.model_executor.layers.quantization.utils.quant_utils import QuantKey
+from vllm.model_executor.layers.quantization.utils.quant_utils import (
+    kFp8DynamicTokenSym,
+)
@@ -71,0 +78,39 @@ def as_quantized_activation(
+
+
+def rms_norm_to_fp8_linear(
+    norm: RMSNorm,
+    x: torch.Tensor,
+    consumer: torch.nn.Module,
+) -> "torch.Tensor | QuantizedActivation":
+    """Fuse RMSNorm with dynamic per-token FP8 for a compatible linear.
+
+    The stock RMSNorm path remains the fallback. The fused path is selected
+    only when the consumer advertises the exact dynamic per-token FP8
+    contract, the norm has the layout supported by the fused CUDA op, and
+    batch-invariant execution is not requested.
+    """
+    quant_key = getattr(consumer, "input_quant_key", None)
+    can_fuse = (
+        quant_key == kFp8DynamicTokenSym
+        and not envs.VLLM_BATCH_INVARIANT
+        and norm.pass_weight
+        and norm.variance_size_override is None
+        and norm.weight.dtype == x.dtype
+        and x.stride(-1) == 1
+    )
+    if not can_fuse:
+        return norm(x)
+
+    data, scale = ops.rms_norm_dynamic_per_token_quant(
+        x,
+        norm.weight.data,
+        norm.variance_epsilon,
+        quant_key.dtype,
+    )
+    return QuantizedActivation(
+        data=data,
+        scale=scale,
+        orig_dtype=x.dtype,
+        orig_shape=x.shape,
+        quant_key=quant_key,
+    )
