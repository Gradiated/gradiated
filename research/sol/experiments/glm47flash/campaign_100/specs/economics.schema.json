{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-100://economics/1.0.0",
  "title": "Campaign 100 conservative GPU economics result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gpu_cost_usd", "gpu_usd_per_million_input_tokens", "gpu_usd_per_million_output_tokens",
    "gpu_usd_per_million_blended_tokens", "gpu_usd_per_million_output_equivalent_tokens",
    "slo_gpu_usd_per_million_blended_tokens", "input_token_weight",
    "non_gpu_sensitivity_fraction", "sensitivity_reserved_usd"
  ],
  "properties": {
    "gpu_cost_usd": {"$ref": "#/$defs/nonnegative_decimal"},
    "gpu_usd_per_million_input_tokens": {"$ref": "#/$defs/nonnegative_decimal"},
    "gpu_usd_per_million_output_tokens": {"$ref": "#/$defs/nonnegative_decimal"},
    "gpu_usd_per_million_blended_tokens": {"$ref": "#/$defs/nonnegative_decimal"},
    "gpu_usd_per_million_output_equivalent_tokens": {"$ref": "#/$defs/nonnegative_decimal"},
    "slo_gpu_usd_per_million_blended_tokens": {"$ref": "#/$defs/nonnegative_decimal"},
    "input_token_weight": {"$ref": "#/$defs/nonnegative_decimal"},
    "non_gpu_sensitivity_fraction": {"$ref": "#/$defs/nonnegative_decimal"},
    "sensitivity_reserved_usd": {"$ref": "#/$defs/nonnegative_decimal"}
  },
  "$defs": {
    "nonnegative_decimal": {"type": "string", "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"}
  }
}
