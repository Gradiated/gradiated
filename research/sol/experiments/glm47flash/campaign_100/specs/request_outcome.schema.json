{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-100://request-outcome/1.0.0",
  "title": "Campaign 100 request outcome JSONL row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id", "completed", "slo_eligible", "slo_compliant", "error",
    "silent_truncation", "input_tokens", "output_tokens", "ttft_ms",
    "inter_token_latency_ms", "end_to_end_ms"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "completed": {"type": "boolean"},
    "slo_eligible": {"type": "boolean"},
    "slo_compliant": {"type": "boolean"},
    "error": {"type": "boolean"},
    "silent_truncation": {"type": "boolean"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "ttft_ms": {"type": ["number", "null"], "minimum": 0},
    "inter_token_latency_ms": {"type": ["number", "null"], "minimum": 0},
    "end_to_end_ms": {"type": ["number", "null"], "minimum": 0}
  }
}
