#!/usr/bin/env python3
"""Run grad-ctl from this checkout without installing it.

`mise run grad-ctl:install` installs the single-file build on PATH instead.
"""
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
if sys.version_info < (3, 10):
    sys.exit('grad-ctl needs Python 3.10 or newer')
sys.path.insert(0, str(HERE / 'src'))
# Commands that work on the repository use this checkout wherever they run from.
os.environ.setdefault('GRAD_CTL_REPO', str(HERE.parents[1]))

from grad_ctl.cli import main  # noqa: E402

main()
